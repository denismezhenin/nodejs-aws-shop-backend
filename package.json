{
  "name": "aws-shop-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Aws shop backend",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
