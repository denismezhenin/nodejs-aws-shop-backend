    "destroy": "cdk destroy",
    "bootstrap": "cdk bootstrap",
    "seed": "tsx scripts/seed.ts"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
