# Dependencies — generated by npm. Reinstalled inside the image via `npm ci`
node_modules
cart-service/node_modules

# Build output — recompiled inside the image
dist
cart-service/dist
cart-service/src/**/*.js
cart-service/src/**/*.js.map
cart-service/src/**/*.d.ts

# CDK synthesis output — large, irrelevant to the container
cdk.out

# Jest coverage reports
coverage

# Git metadata
.git
.gitignore

# Secrets 
.env
.env.*

# Other services / infrastructure that are not part of the Cart image.
src
scripts
sql
test

# Docs, editor and OS cruft, and EB CLI metadata.
*.md
.vscode
.idea
.DS_Store
.elasticbeanstalk

# Docker files themselves don't need to be in the build context.
Dockerfile
.dockerignore
